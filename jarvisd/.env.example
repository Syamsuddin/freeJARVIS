# Salin ke jarvisd/.env. Token VPS TIDAK di sini (Keychain: freejarvis.stt).
# JANGAN pernah menambahkan ANTHROPIC_API_KEY (docs/20).
JARVIS_WS_PORT=8764
JARVIS_STT_URL=https://stt.example.id
JARVIS_STT_TIMEOUT_S=4
JARVIS_WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
JARVIS_WHISPER_CPP_MODEL=~/Library/Application Support/FreeJarvis/models/ggml-small.bin
JARVIS_DATA_DIR=~/Library/Application Support/FreeJarvis
JARVIS_LOG_LEVEL=INFO
